# Thin keyframe worker (#530). Toolchain plus app. No seed COPY. No .vj-baked.
#
# Build the toolchain first (no weight layers):
#   docker build -f deploy/runtime.Dockerfile --target toolchain -t vivijure-backend-toolchain .
# Then:
#   docker build -f deploy/Dockerfile.thin --build-arg TOOLCHAIN_REF=vivijure-backend-toolchain .
#
# After the first published toolchain tag, pin TOOLCHAIN_REF by tag and digest.
# TOOLCHAIN_REF may be the stills weights base (deploy/stills-weights.Dockerfile, #564): then a cold
# keyframe worker finds the stills set in the image and pulls nothing. See docs/stills-weights-base.md.
# On the bare toolchain, the worker pulls the stills set from R2 at its first job.

ARG TOOLCHAIN_REF=vivijure-backend-toolchain
FROM ${TOOLCHAIN_REF}

WORKDIR /opt/vivijure
COPY src/vivijure_backend /opt/vivijure/vivijure_backend
COPY deploy/smoke_imports.py /opt/vivijure/smoke_imports.py

ENV VJ_VOLUME_ROOT=/runpod-volume \
    VJ_VOLUME_KIND=global \
    VJ_VOLUME_SELF_PRELOAD=0

CMD ["conda", "run", "--no-capture-output", "-n", "vivijure", "python", "-u", "-m", "vivijure_backend.worker"]
