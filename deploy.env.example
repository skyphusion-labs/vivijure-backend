# deploy.env.example -- copy to deploy.env, fill it in, then run ./deploy.sh
#
#   cp deploy.env.example deploy.env    # then edit deploy.env
#
# deploy.env holds YOUR keys and is gitignored. NEVER commit the real deploy.env.
# Every value is for YOUR OWN RunPod + Cloudflare accounts; you pay your own bills.
# What each value is, and where to click to get it, is in docs/deploy.md.
#
# This file stands up the GPU render engine (the "vivijure-backend" box on the map in
# docs/constellation.md). When it finishes it prints an ENDPOINT ID. You paste that id into the
# Studio's own deploy.env as RUNPOD_ENDPOINT_ID, and the two halves are wired together.

# ---- RunPod: the account that rents the GPU (docs/deploy.md step 1) ----------
# API key: runpod.io -> Settings -> API Keys -> create a read/write key. This is how the script
# creates your endpoint. Keep it safe.
RUNPOD_API_KEY=

# ---- R2 storage keys (docs/deploy.md step 2) --------------------------------
# Cloudflare R2 is where the job files live: the Studio writes a job in, the GPU writes the
# finished video back out. Use the SAME bucket your Studio uses. Make the keys at:
# dash.cloudflare.com -> R2 -> Manage R2 API Tokens -> Create API token, "Object Read & Write".
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket name (defaults to vivijure, matching the Studio default).
R2_BUCKET=vivijure
# The S3 address of your R2. Leave blank and it is built for you IF you fill in
# CLOUDFLARE_ACCOUNT_ID below; otherwise paste it: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Your Cloudflare account id (dash -> right sidebar "Account ID"). Only used to build R2_ENDPOINT
# for you when R2_ENDPOINT is left blank. Not a secret.
CLOUDFLARE_ACCOUNT_ID=

# ---- The image and the GPU (docs/deploy.md steps 3-4) -----------------------
# The published, ready-to-run render image. It already has every model baked in, so there is
# nothing to build and nothing else to download. Leave this as-is unless you forked the code.
# Pin note: this example tracks the current promoted backend release (the tag live on the RunPod
# serverless endpoint); bump it when a newer backend-vX.Y.Z is promoted.
BACKEND_IMAGE=ghcr.io/skyphusion-labs/vivijure-backend:0.4.9

# Which GPU card(s) the endpoint may use, as a comma-separated list of RunPod GPU type ids. The
# render engine needs a big, modern card (see docs/deploy.md "Picking a GPU"). The exact id
# strings show up in the RunPod dashboard when you add a Serverless endpoint; these two are the
# standard for this backend. The scheduler uses whichever has stock.
GPU_TYPE_IDS=NVIDIA H200,NVIDIA B200

# ---- Sizing knobs (safe defaults; docs/deploy.md "Every setting explained") --
# The endpoint name shown in your RunPod dashboard.
ENDPOINT_NAME=vivijure-backend
# Most workers running at once. Each render holds one worker until it finishes. Start at 3.
WORKERS_MAX=3
# Fewest workers kept always-on. Keep this 0 so an idle endpoint costs you nothing.
WORKERS_MIN=0
# Scratch disk per worker, in GB. The image is large, so give it room. 100 is a safe floor.
CONTAINER_DISK_GB=100
# Seconds a warm worker waits for the next job before it shuts down. 5 is fine.
IDLE_TIMEOUT=5
# Optional hard stop: kill any single job that runs longer than this many milliseconds. Leave
# blank for no limit. 1800000 = 30 minutes is a reasonable guard against a stuck job.
EXECUTION_TIMEOUT_MS=
